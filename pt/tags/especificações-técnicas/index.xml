    <item>
      <title>Visão Geral Abrangente da Máquina CNC de Furação Horizontal e Fresagem HB-110-30T</title>
      <link>https://mis3085.github.io/docs-chungsing/pt/products/hb-110-30t/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      
      <guid>https://mis3085.github.io/docs-chungsing/pt/products/hb-110-30t/</guid>
      <description>&lt;h2 class=&#34;relative group&#34;&gt;Introdução 
